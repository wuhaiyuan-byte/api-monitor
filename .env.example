DATABASE_URL=sqlite+aiosqlite:///./api_monitor.db
# OSS file monitor: Fernet key for encrypting per-monitor access key secrets.
# If unset, the backend will auto-generate a key on first startup and persist
# it to OSS_ENC_KEY_FILE (default /app/data/oss_fernet.key) so secrets survive
# container restarts. The docker-compose.yml mounts ./data:/app/data for this.
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OSS_ENC_KEY=