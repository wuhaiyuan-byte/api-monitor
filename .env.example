DATABASE_URL=sqlite+aiosqlite:///./api_monitor.db
# OSS file monitor: Fernet key for encrypting per-monitor access key secrets.
# Leave unset to auto-generate an ephemeral key on startup (secrets won't survive restart).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OSS_ENC_KEY=